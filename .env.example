# ══════════════════════════════════════════════════════════════
# BRATECC Connect AI - Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e ajuste os valores

# ─── BANCO DE DADOS ───
POSTGRES_USER=bratecc
POSTGRES_PASSWORD=bratecc2026
POSTGRES_DB=bratecc_db
# Se o PostgreSQL do Windows já usa 5432, use 5433 aqui e no DATABASE_URL do backend/.env
DB_PORT_EXTERNAL=5433

# ─── JWT ───
JWT_SECRET=bratecc-jwt-secret-mude-isso-em-producao
JWT_EXPIRES_IN=7d

# ─── SERVIDOR ───
NODE_ENV=production
APP_PORT=80
FRONTEND_URL=http://localhost

# ─── GOOGLE GEMINI AI (opcional) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── META WHATSAPP BUSINESS API ───
# Token: https://developers.facebook.com/apps → WhatsApp → API Setup → Temporary Access Token
# ATENÇÃO: o nome correto da var é META_WHATSAPP_TOKEN (não META_ACCESS_TOKEN).
# O código lê só essa, qualquer outro nome resulta em fallback de texto livre.
META_WHATSAPP_TOKEN=
# Verify Token: Definido por você, usado na configuração do webhook na Meta
META_VERIFY_TOKEN=bratecc-verify-token-2026
# WhatsApp Line ID (Phone Number ID): WhatsApp → API Setup → Phone Number ID
WHATSAPP_LINE_ID=942923015574587

# ─── TEMPLATES HSM (handshake 2 etapas) ───
# Nome dos templates aprovados na Meta. Os textos sugeridos estão em
# backend/src/services/hsmTemplates.js — cadastre-os com esse conteúdo
# (parâmetros nomeados: {{nome}}, {{segmento}}, {{produtos_servico}}).
# Se você ainda não tem templates separados, pode apontar os dois para o mesmo
# template aprovado (ex.: ambos = hsmbra1). Quando aprovar templates distintos,
# mude HSM_TEMPLATE_AVANCO para o template do segundo contato.
HSM_TEMPLATE_INICIO=hsmbra1
HSM_TEMPLATE_AVANCO=hsmbra1
# HSM específico para convites de evento (Eventos × Empresas / Eventos × Associados).
HSM_TEMPLATE_EVENTO=hsmbraevent
HSM_TEMPLATE_LANGUAGE=pt_BR

# ─── ADMIN INICIAL (usado pelo seed) ───
ADMIN_EMAIL=admin@bratecc.com
ADMIN_PASSWORD=admin123

# ─── SEED ───
# minimal = banco zerado, só cria o admin (recomendado para teste)
# 1       = popula com dados demo (6 usuários, associados, empresas, eventos, matches)
# (vazio) = não mexe no banco no boot
# IMPORTANTE: o seed APAGA TODOS OS DADOS antes de rodar.
RUN_DB_SEED=
