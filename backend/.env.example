# ═══════════════════════════════════════════════════════════
# BRATECC Connect AI - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════

# Banco de Dados PostgreSQL
# Docker na máquina com Postgres nativo: use a porta publicada (ex.: 5433), não 5432
DATABASE_URL="postgresql://bratecc:bratecc2026@localhost:5433/bratecc_db?schema=public"

# JWT Secret (gere uma chave segura para produção)
JWT_SECRET="sua-chave-secreta-muito-segura-aqui-12345"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:3000"

# Google Gemini AI
GEMINI_API_KEY="sua-api-key-do-gemini"
GEMINI_MODEL="gemini-2.5-flash"
